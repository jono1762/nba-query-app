# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Local Postgres (docker compose). These defaults are only for your laptop.
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba_local_dev
POSTGRES_DB=nba
DATABASE_URL=postgresql://nba:nba_local_dev@localhost:5432/nba
# Read-only login that AI-written SQL runs as (create it once, see README).
READER_DATABASE_URL=postgresql://nba_app_reader:reader_local_dev@localhost:5432/nba

